# ============================================================
# AI Interview Analyzer - Environment Configuration
# Copy this file to ".env" and fill in real values before running.
# NEVER commit your actual .env file to version control.
# ============================================================

# Application
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-long-random-secret-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Database (SQLite by default; swap for Postgres/MySQL URL in production)
DATABASE_URL=sqlite:///interview_analyzer.db

# File storage limits
MAX_CONTENT_LENGTH_MB=250
UPLOAD_FOLDER=uploads

# AI / Speech engine
# transcription backend: "google" (SpeechRecognition, no download) or "whisper" (offline, heavier)
TRANSCRIPTION_BACKEND=google
WHISPER_MODEL_SIZE=base

# Session / Security
SESSION_COOKIE_SECURE=False
PASSWORD_MIN_LENGTH=8

# Admin bootstrap (used by scripts/create_admin.py)
ADMIN_EMAIL=admin@interviewanalyzer.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# Pagination
ITEMS_PER_PAGE=10
